*.pt
/runs/
/logs/
/wandb/
*.xyz
/checkpoints/
*.model
/results/
*.db

# The golden references are committed on purpose: they are the numerical
# contract the test suite asserts against, so the structures and the tiny
# anchor checkpoints have to travel with the repository. The patterns above
# (*.xyz, *.model, *.pt) would otherwise silently refuse them, and a golden
# that is not in the clone is not a golden.
!tests/golden/fixtures/*.xyz
!tests/golden/datasets/*.xyz
!tests/golden/models/*.model
!tests/golden/models/*.pt

.benchmarks/
*.cube

# coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/

# local planning docs (not for the public repo)
/doc

# EnvHead local configurations, documentation, tests and generated artifacts.
/mace/modules/envhead/Foundation/
/mace/modules/envhead/archive/
/mace/modules/envhead/runs/
/mace/modules/envhead/docs/
/tests/extensions/envhead/
/tests/unit/test_envhead_*.py
/mace/modules/envhead/validation/
/mace/modules/envhead/validation-*
/mace/modules/envhead/ARCHITECTUREv*.md
/mace/modules/envhead/IMPLEMENTATIONv*.md

# Local research tools and paper-specific experiments.
/mace/modules/envhead/private/
